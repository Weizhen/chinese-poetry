[
    {
        "title": "寄遠曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "美人來去春江暖，江頭無人湘水滿。",
            "浣沙石上水禽栖，江南路長春日短。",
            "蘭舟桂楫常渡江，無因重寄雙瓊璫。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 1
    },
    {
        "title": "行路難",
        "author": "張籍",
        "biography": "",
        "content": [
            "湘東行人長歎息，十年離家歸未得。弊裘羸馬苦難行，",
            "龍蟠泥中未有雲，不能生彼升天翼。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 2
    },
    {
        "title": "征婦怨",
        "author": "張籍",
        "biography": "",
        "content": [
            "九月匈奴殺邊將，漢軍全沒遼水上。萬里無人收白骨，",
            "夫死戰場子在腹，妾身雖存如晝燭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 3
    },
    {
        "title": "白紵歌",
        "author": "張籍",
        "biography": "",
        "content": [
            "皎皎白紵白且鮮，將作春衣稱少年。裁縫長短不能定，",
            "衣裳著時寒食下，還把玉鞭鞭白馬。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 4
    },
    {
        "title": "野老歌",
        "author": "張籍",
        "biography": "",
        "content": [
            "老農家貧在山住，耕種山田三四畝。苗疏稅多不得食，",
            "西江賈客珠百斛，船中養犬長食肉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 5
    },
    {
        "title": "寄衣曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "織素縫衣獨苦辛，遠因回使寄征人。官家亦自寄衣去，",
            "殷勤為看初著時，征夫身上宜不宜。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 6
    },
    {
        "title": "送遠曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "戲馬台南山簇簇，山邊飲酒歌別曲。行人醉後起登車，",
            "願君到處自題名，他日知君從此去。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 7
    },
    {
        "title": "築城詞",
        "author": "張籍",
        "biography": "",
        "content": [
            "築城處，千人萬人齊把杵。",
            "重重土堅試行錐，軍吏執鞭催作遲。",
            "來時一年深磧裏，盡著短衣渴無水。",
            "力盡不得拋杵聲，杵聲未盡人皆死。",
            "家家養男當門戶，今日作君城下土。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 8
    },
    {
        "title": "猛虎行",
        "author": "張籍",
        "biography": "",
        "content": [
            "南山北山樹冥冥，猛虎白日繞林行。",
            "向晚一身當道食，山中麋鹿盡無聲。",
            "年年養子在空谷，雌雄上山不相逐。",
            "谷中近窟有山村，長向村家取黃犢。",
            "五陵年少不敢射，空來林下看行迹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 9
    },
    {
        "title": "別離曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "行人結束出門去，幾時更踏門前路。",
            "憶昔君初納采時，不言身屬遼陽戍。",
            "早知今日當別離，成君家計良爲誰。",
            "男兒生身自有役，那得誤我少年時。",
            "不如逐君征戰死，誰能獨老空閨裏。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 10
    },
    {
        "title": "牧童詞",
        "author": "張籍",
        "biography": "",
        "content": [
            "遠牧牛，繞村四面禾黍稠。陂中饑烏啄牛背，",
            "隔堤吹葉應同伴，還鼓長鞭三四聲。牛牛食草莫相觸，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 11
    },
    {
        "title": "沙堤行，呈裴相公",
        "author": "張籍",
        "biography": "",
        "content": [
            "長安大道沙爲堤，早風無塵雨無泥。",
            "宮中玉漏下三刻，朱衣導騎丞相來。",
            "路傍高樓息歌吹，千車不行行者避。",
            "街官閭吏相傳呼，當前十里惟空衢。",
            "白麻詔下移相印，新堤未成舊堤盡。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 12
    },
    {
        "title": "求仙行",
        "author": "張籍",
        "biography": "",
        "content": [
            "漢皇欲作飛仙子，年年采藥東海裏。蓬萊無路海無邊，",
            "九皇真人終不下，空向離宮祠太乙。丹田有氣凝素華，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 13
    },
    {
        "title": "古釵歎",
        "author": "張籍",
        "biography": "",
        "content": [
            "古釵墮井無顏色，百尺泥中今復得。",
            "鳳凰宛轉有古儀，欲爲首飾不稱時。",
            "女伴傳看不知主，羅袖拂拭生光輝。",
            "蘭膏已盡股半折，雕文刻樣無年月。",
            "雖離井底入匣中，不用還與墜時同。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 14
    },
    {
        "title": "各東西",
        "author": "張籍",
        "biography": "",
        "content": [
            "遊人別，一東複一西。出門相背兩不返，惟信車輪與馬蹄。",
            "道路悠悠不知處，山高海闊誰辛苦。遠遊不定難寄書，",
            "我今與子非一身，安得死生不相棄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 15
    },
    {
        "title": "節婦吟，寄東平李司空師道",
        "author": "張籍",
        "biography": "",
        "content": [
            "君知妾有夫，贈妾雙明珠。",
            "感君纏綿意，繫在紅羅襦。",
            "妾家高樓連苑起，良人執戟明光裏。",
            "知君用心如日月，事夫誓擬同生死。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 16
    },
    {
        "title": "宴客詞",
        "author": "張籍",
        "biography": "",
        "content": [
            "上客不用顧金羈，主人有酒君莫違。",
            "請君看取園中花，地上漸多枝上稀。",
            "山頭樹影不見石，溪水無風應更碧。",
            "人人齊醉起舞時，誰覺翻衣與倒幘。",
            "明朝花盡人已去，此地獨來空繞樹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 17
    },
    {
        "title": "永嘉行",
        "author": "張籍",
        "biography": "",
        "content": [
            "黃頭鮮卑入洛陽，胡兒執戟升明堂。",
            "晉家天子作降虜，公卿奔走如牛羊。",
            "紫陌旌幡暗相觸，家家雞犬驚上屋。",
            "婦人出門隨亂兵，夫死眼前不敢哭。",
            "九州諸侯自顧土，無人領兵來護主。",
            "北人避胡多在南，南人至今能晉語。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 18
    },
    {
        "title": "採蓮曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "秋江岸邊蓮子多，採蓮女兒凭船歌。",
            "青房圓實齊戢戢，爭前競折漾微波。",
            "試牽綠莖下尋藕，斷處絲多刺傷手。",
            "白練束腰袖半卷，不插玉釵妝梳淺。",
            "船中未滿度前洲，借問阿誰家住遠。",
            "歸時共待暮潮上，自弄芙蓉還蕩槳。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 19
    },
    {
        "title": "傷歌行",
        "author": "張籍",
        "biography": "",
        "content": [
            "黃門詔下促收捕，京兆尹系禦史府。出門無複部曲隨，",
            "身著青衫騎惡馬，中門之外無送者。郵夫防吏急喧驅，",
            "高堂舞榭鎖管弦，美人遙望西南天。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 20
    },
    {
        "title": "吳宮怨",
        "author": "張籍",
        "biography": "",
        "content": [
            "吳宮四面秋江水，江清露白芙蓉死。吳王醉後欲更衣，",
            "君心與妾既不同，徒向君前作歌舞。茱萸滿宮紅實垂，",
            "白日在天光在地，君今那得長相棄。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 21
    },
    {
        "title": "北邙行",
        "author": "張籍",
        "biography": "",
        "content": [
            "洛陽北門北邙道，喪車轔轔入秋草。車前齊唱薤露歌，",
            "千金立碑高百尺，終作誰家柱下石。山頭松柏半無主，",
            "人居朝市未解愁，請君暫向北邙遊。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 22
    },
    {
        "title": "關山月",
        "author": "張籍",
        "biography": "",
        "content": [
            "秋月朗朗關山上，山中行人馬蹄響。關山秋來雨雪多，",
            "軍中探騎暮出城，伏兵暗處低旌戟。溪水連天霜草平，",
            "可憐萬國關山道，年年戰骨多秋草。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 23
    },
    {
        "title": "隴頭行",
        "author": "張籍",
        "biography": "",
        "content": [
            "隴頭路斷人不行，胡騎夜入涼州城。",
            "漢兵處處格鬬死，一朝盡沒隴西地。",
            "驅我邊人胡中去，散放牛羊食禾黍。",
            "去年中國養子孫，今著氈裘學胡語。",
            "誰能更使李輕車，收取涼州入漢家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 24
    },
    {
        "title": "楚妃歎",
        "author": "張籍",
        "biography": "",
        "content": [
            "湘雲初起江沉沉，君王遙在雲夢林。",
            "江南雨多旌旗暗，臺下朝朝春水深。",
            "章華殿前朝萬國，君心獨自無終極。",
            "楚兵滿地能逐禽，誰用一身騁筋力。",
            "西江若飜雲夢中，麋鹿死盡應還宮。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 25
    },
    {
        "title": "春日行",
        "author": "張籍",
        "biography": "",
        "content": [
            "春日融融池上暖，竹牙出土蘭心短。",
            "草堂晨起酒半醒，家僮報我園花滿。",
            "頭上皮冠未曾整，直入花間不尋徑。",
            "樹樹殷勤盡遶行，攀枝未徧春日暝。",
            "不用積金著青天，不用服藥求神仙。",
            "但願園裏花長好，一生飲酒花前老。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 26
    },
    {
        "title": "秋夜長",
        "author": "張籍",
        "biography": "",
        "content": [
            "秋天如水夜未央，天漢東西月色光。愁人不寐畏枕席，",
            "白露滿田風嫋嫋，千聲萬聲鶡鳥鳴。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 27
    },
    {
        "title": "白鼉鳴",
        "author": "張籍",
        "biography": "",
        "content": [
            "天欲雨，有東風，南溪白鼉鳴窟中。六月人家井無水，"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 28
    },
    {
        "title": "洛陽行",
        "author": "張籍",
        "biography": "",
        "content": [
            "洛陽宮闕當中州，城上峨峨十二樓。翠華西去幾時返，",
            "六街朝暮鼓冬冬，禁兵持戟守空宮。百官月月拜章表，",
            "陌上老翁雙淚垂，共說武皇巡幸時。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 29
    },
    {
        "title": "春江曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "春江無雲潮水平，蒲心出水鳧雛鳴。",
            "長干夫壻愛遠行，自染春衣縫已成。",
            "妾身生長金陵側，去年隨夫住江北。",
            "春來未到父母家，舟小風多渡不得。",
            "欲辭舅姑先問人，私向江頭祭水神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 30
    },
    {
        "title": "送遠曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "吳門向西流水長，水長柳暗煙茫茫。行人送客各惆悵，",
            "行人告我掛帆去，此去何時返故鄉。殷勤振衣兩相囑，",
            "行人行處求知親，送君去去徒酸辛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 31
    },
    {
        "title": "塞下曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "邊州八月修城堡，候騎先燒磧中草。",
            "胡風吹沙度隴飛，隴頭林木無北枝。",
            "將軍閱兵青塞下，鳴鼓逢逢促獵圍。",
            "天寒山路石斷裂，白日不銷帳上雪。",
            "烏孫國亂多降胡，詔使名王持漢節。",
            "年年征戰不得閑，邊人殺盡唯空山。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 32
    },
    {
        "title": "董逃行",
        "author": "張籍",
        "biography": "",
        "content": [
            "洛陽城頭火曈曈，亂兵燒我天子宮。",
            "宮城南面有深山，盡將老幼藏其間。",
            "重巖爲屋橡爲食，丁男夜行候消息。",
            "聞道官軍猶掠人，舊里如今歸未得。",
            "董逃行，漢家幾時重太平。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 33
    },
    {
        "title": "少年行",
        "author": "張籍",
        "biography": "",
        "content": [
            "少年從獵出長楊，禁中新拜羽林郎。獨對輦前射雙虎，",
            "百里報仇夜出城，平明還在娼樓醉。遙聞虜到平陵下，",
            "不為六郡良家子，百戰始取邊城功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 34
    },
    {
        "title": "白頭吟",
        "author": "張籍",
        "biography": "",
        "content": [
            "請君膝上琴，彈我白頭吟。",
            "憶昔君前嬌笑語，兩情宛轉如縈素。",
            "宮中爲我起高樓，更開華池種芳樹。",
            "春天百草秋始衰，棄我不待白頭時。",
            "羅襦玉珥色未暗，今朝已道不相宜。",
            "揚州青銅作明鏡，暗中持照不見影。",
            "人心回互自無窮，眼前好惡那能定。",
            "君恩已去若再返，菖蒲花生月長滿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 35
    },
    {
        "title": "將軍行",
        "author": "張籍",
        "biography": "",
        "content": [
            "彈箏峽東有胡塵，天子擇日拜將軍。",
            "蓬萊殿前賜六纛，還領禁兵爲部曲。",
            "當朝受詔不辭家，夜向咸陽原上宿。",
            "戰車彭彭旌旗動，三十六軍齊上隴。",
            "隴頭戰勝夜亦行，分兵處處收舊城。",
            "胡兒殺盡陰磧暮，擾擾唯有牛羊聲。",
            "邊人親戚曾戰沒，今逐官軍收舊骨。",
            "磧西行見萬里空，幕府獨奏將軍功。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 36
    },
    {
        "title": "賈客樂",
        "author": "張籍",
        "biography": "",
        "content": [
            "金陵向西賈客多，船中生長樂風波。",
            "欲發移船近江口，船頭祭神各澆酒。",
            "停杯共說遠行期，入蜀經蠻誰別離。",
            "金多衆中爲上客，夜夜算緡眠獨遲。",
            "秋江初月猩猩語，孤帆夜發瀟湘渚。",
            "水工持檝防暗灘，直過山邊及前侶。",
            "年年逐利西復東，姓名不在縣籍中。",
            "農夫稅多長辛苦，棄業長爲販寶翁。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 37
    },
    {
        "title": "羈旅行",
        "author": "張籍",
        "biography": "",
        "content": [
            "遠客出門行路難，停車斂策在門端。",
            "荒城無人霜滿路，野火燒橋不得度。",
            "寒蟲入窟鳥歸巢，僮僕問我誰家去。",
            "行尋田頭暝未息，雙轂長轅礙荆棘。",
            "緣岡入澗投田家，主人舂米爲夜食。",
            "晨雞喔喔茅屋傍，行人起掃車上霜。",
            "舊山已別行已遠，身計未成難復返。",
            "長安陌上相識稀，遙望天山白日晚。",
            "誰能聽我辛苦行，爲向君前歌一聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 38
    },
    {
        "title": "車遙遙",
        "author": "張籍",
        "biography": "",
        "content": [
            "征人遙遙出古城，雙輪齊動駟馬鳴。山川無處不歸路，",
            "驚麏遊兔在我傍，獨唱鄉歌對僮僕。君家大宅鳳城隅，",
            "門前舊轍久已平，無由複得君消息。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 39
    },
    {
        "title": "妾薄命",
        "author": "張籍",
        "biography": "",
        "content": [
            "薄命婦，良家子，無事從軍去萬里。",
            "漢家天子平四夷，護羌都尉裹尸歸。",
            "念君此行爲死別，對君裁縫泉下衣。",
            "與君一日爲夫婦，千年萬歲亦相守。",
            "君愛龍城征戰功，妾願青樓歌樂同。",
            "人生各各有所欲，詎得將心入君腹。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 40
    },
    {
        "title": "朱鷺",
        "author": "張籍",
        "biography": "",
        "content": [
            "翩翩兮朱鷺，來泛春塘棲綠樹。羽毛如翦色如染，",
            "誰知豪家網爾軀，不如飲啄江海隅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 41
    },
    {
        "title": "遠別離",
        "author": "張籍",
        "biography": "",
        "content": [
            "蓮葉團團杏花拆，長江鯉魚鬐鬣赤。念君少年棄親戚，",
            "幾時斷得城南陌，勿使居人有行役。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 42
    },
    {
        "title": "楚宮行",
        "author": "張籍",
        "biography": "",
        "content": [
            "章華宮中九月時，桂花半落紅橘垂。",
            "江頭騎火照輦道，君王夜從雲夢歸。",
            "霓旌鳳蓋到雙闕，臺上重重歌吹發。",
            "千門萬戶開相當，燭籠左右列成行。",
            "下輦更衣入洞房，洞房侍女盡焚香。",
            "玉階羅幕微有霜，齊言此夕樂未央。",
            "玉酒湛湛盈華觴，絲竹次第鳴中堂。",
            "巴姬起舞向君王，迴身垂手結明璫。",
            "願君千年萬年壽，朝出射麋夜飲酒。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 43
    },
    {
        "title": "江南行",
        "author": "張籍",
        "biography": "",
        "content": [
            "江南人家多橘樹，吳姬舟上織白苧。土地卑濕饒蟲蛇，",
            "清莎覆城竹為屋，無井家家飲潮水。長幹午日沽春酒，",
            "江南風土歡樂多，悠悠處處盡經過。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 44
    },
    {
        "title": "烏夜啼引",
        "author": "張籍",
        "biography": "",
        "content": [
            "秦烏啼啞啞，夜啼長安吏人家。",
            "吏人得罪囚在獄，傾家賣產將自贖。",
            "少婦起聽夜啼烏，知是官家有赦書。",
            "下牀心喜不重寐，未明上堂賀舅姑。",
            "少婦語啼烏，汝啼慎勿虛。",
            "借汝庭樹作高巢，年年不令傷爾雛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 45
    },
    {
        "title": "促促詞",
        "author": "張籍",
        "biography": "",
        "content": [
            "促促複促促，家貧夫婦歡不足。今年為人送租船，",
            "家家桑麻滿地黑，念君一身空努力。",
            "願教牛蹄團團羊角直，君身常在應不得。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 46
    },
    {
        "title": "宛轉行",
        "author": "張籍",
        "biography": "",
        "content": [
            "華屋重翠幄，綺席雕象床。遠漏微更疏，薄衾中夜涼。",
            "爐氣暗裴徊，寒燈背斜光。妍姿結宵態，寢臂幽夢長。",
            "宛轉複宛轉，憶君更未央。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 47
    },
    {
        "title": "短歌行",
        "author": "張籍",
        "biography": "",
        "content": [
            "青天蕩蕩高且虛，上有白日無根株。流光暫出還入地，",
            "玉卮盛酒置君前，再拜願君千萬年。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 48
    },
    {
        "title": "山頭鹿",
        "author": "張籍",
        "biography": "",
        "content": [
            "山頭鹿，角芟芟，尾促促。貧兒多租輸不足，",
            "縣家唯憂少軍食，誰能令爾無死傷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 49
    },
    {
        "title": "湘江曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "湘水無潮秋水闊，湘中月落行人發。",
            "送人發，送人歸，白蘋茫茫鷓鴣飛。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 50
    },
    {
        "title": "楚妃怨",
        "author": "張籍",
        "biography": "",
        "content": [
            "梧桐葉下黃金井，橫架轆轤牽素綆。",
            "美人初起天未明，手拂銀瓶秋水冷。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 51
    },
    {
        "title": "離宮怨",
        "author": "張籍",
        "biography": "",
        "content": [
            "高堂別館連湘渚，長向春光開萬戶。",
            "荊王去去不復來，宮中美人自歌舞。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 52
    },
    {
        "title": "成都曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "錦江近西煙水綠，新雨山頭荔枝熟。",
            "萬里橋邊多酒家，遊人愛向誰家宿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 53
    },
    {
        "title": "寒塘曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "寒塘沉沉柳葉疏，水暗人語驚棲鳧。",
            "舟中少年醉不起，持燭照水射遊魚。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 54
    },
    {
        "title": "春別曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "長江春水綠堪染，蓮葉出水大如錢。",
            "江頭橘樹君自種，那不長系木蘭船。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 55
    },
    {
        "title": "春堤曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "野塘鵁鶄飛樹頭，綠蒲紫菱蓋碧流。",
            "狂客誰家愛雲水，日日獨來城下游。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 56
    },
    {
        "title": "烏棲曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "西山作宮潮滿池，宮鳥曉鳴茱萸枝。",
            "吳姬採蓮自唱曲，君王昨夜舟中宿。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 57
    },
    {
        "title": "雀飛多",
        "author": "張籍",
        "biography": "",
        "content": [
            "雀飛多，觸網羅，網羅高樹顛。",
            "汝飛蓬蒿下，勿復投身網羅間。",
            "粟積倉，禾在田。",
            "巢之雛，望其母來還。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 58
    },
    {
        "title": "泗水行",
        "author": "張籍",
        "biography": "",
        "content": [
            "泗水流急石纂纂，鯉魚上下紅尾短。",
            "春冰銷散日華滿，行舟往來浮橋斷。",
            "城邊魚市人早行，水煙漠漠多棹聲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 59
    },
    {
        "title": "廢居行",
        "author": "張籍",
        "biography": "",
        "content": [
            "胡馬崩騰滿阡陌，都人避亂唯空宅。",
            "宅邊青桑垂宛宛，野蠶食葉還成繭。",
            "黃雀銜草入燕窠，嘖嘖啾啾白日晚。",
            "去時禾黍埋地中，飢兵掘土翻重重。",
            "鴟梟養子庭樹上，曲牆空屋多旋風。",
            "亂定幾人還本土，唯有官家重作主。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 60
    },
    {
        "title": "寄菖蒲",
        "author": "張籍",
        "biography": "",
        "content": [
            "石上生菖蒲，一寸十二節。",
            "仙人勸我食，令我頭青面如雪。",
            "逢人寄君一絳囊，書中不得傳此方。",
            "君能來作棲霞侶，與君同入丹玄鄉。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 61
    },
    {
        "title": "江村行",
        "author": "張籍",
        "biography": "",
        "content": [
            "南塘水深蘆筍齊，下田種稻不作畦。耕場磷磷在水底，",
            "水淹手足盡有瘡，山虻繞身飛颺颺。桑林椹黑蠶再眠，",
            "一年耕種長苦辛，田熟家家將賽神。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 62
    },
    {
        "title": "樵客吟",
        "author": "張籍",
        "biography": "",
        "content": [
            "上山采樵選枯樹，深處樵多出辛苦。秋來野火燒櫟林，",
            "日西待伴同下山，竹擔彎彎向身曲。共知路傍多虎窟，",
            "采樵客，莫采松與柏。松柏生枝直且堅，與君作屋成家宅。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 63
    },
    {
        "title": "湖南曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "瀟湘多別離，風起芙蓉洲。江上人已遠，夕陽滿中流。",
            "鴛鴦東南飛，飛上青山頭。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 64
    },
    {
        "title": "春水曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "鴨鴨，觜唼唼。",
            "青蒲生，春水狹。",
            "蕩漾木蘭船，中有雙少年。",
            "少年醉，鴨不起。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 65
    },
    {
        "title": "雲童行",
        "author": "張籍",
        "biography": "",
        "content": [
            "雲童童，白龍之尾垂江中。",
            "今年天旱不作雨，水足牆上有禾黍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 66
    },
    {
        "title": "新桃行",
        "author": "張籍",
        "biography": "",
        "content": [
            "桃生葉婆娑，枝葉四向多。高未出牆顛，蒿莧相淩摩。",
            "植之三年餘，今年初試花。秋來已成實，其陰良已嘉。",
            "青蟬不來鳴，安得迅羽過。常惡牽絲蟲，蒙冪成網羅。",
            "顧托戲兒童，勿折吾柔柯。明年結其實，磊磊充汝家。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 67
    },
    {
        "title": "憶遠曲",
        "author": "張籍",
        "biography": "",
        "content": [
            "水上山沉沉，征途複繞林。途荒人行少，馬跡猶可尋。",
            "雪中獨立樹，海口失侶禽。離憂如長線，千里縈我心。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 68
    },
    {
        "title": "長塘湖",
        "author": "張籍",
        "biography": "",
        "content": [
            "長塘湖，一斛水中半斛魚。",
            "大魚如柳葉，小魚如針鋒，水濁誰能辨真龍。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 69
    },
    {
        "title": "廢瑟詞",
        "author": "張籍",
        "biography": "",
        "content": [
            "古瑟在匣誰複識，玉柱顛倒朱絲黑。千年曲譜不分明，",
            "幾時天下復古樂，此瑟還奏雲門曲。"
        ],
        "notes": [
            ""
        ],
        "volume": "卷三百八十二",
        "no#": 70
    }
]
